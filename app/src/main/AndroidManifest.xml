<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    package="com.google.ar.core.examples.kotlin.helloar">

  <uses-permission android:name="android.permission.CAMERA"/>
  <!-- マップ画面で ESP32 のビーコンを BLE でスキャンする（Android 11 以下は BLUETOOTH / BLUETOOTH_ADMIN、12 以上は BLUETOOTH_SCAN） -->
  <uses-permission android:name="android.permission.BLUETOOTH" android:maxSdkVersion="30" />
  <uses-permission android:name="android.permission.BLUETOOTH_ADMIN" android:maxSdkVersion="30" />
  <uses-permission android:name="android.permission.BLUETOOTH_SCAN" />
  <!-- 近接対戦で GATT 接続と受付の広告を行う -->
  <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />
  <uses-permission android:name="android.permission.BLUETOOTH_ADVERTISE" />
  <!-- BLUETOOTH_SCAN に neverForLocation を付けるとビーコンの結果が除かれることがあるので、位置情報の権限ももらう -->
  <!-- Android 12 からは FINE を求めるときに COARSE も一緒に求める（ユーザーは「おおよそ」だけを選ぶこともできる） -->
  <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
  <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
  <uses-feature android:name="android.hardware.bluetooth_le" android:required="false" />
  <!-- 対戦（Supabase）に使う -->
  <uses-permission android:name="android.permission.INTERNET"/>
  <!-- Required to post notifications for Android T+ devices -->

  <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
  <!-- Google Play assumes that certain hardware related permissions indicate that the underlying
       hardware features are required by default.
       (https://developer.android.com/topic/arc/manifest.html#implied-features). -->
  <uses-feature android:name="android.hardware.camera" android:required="true" />
  <uses-feature android:name="android.hardware.camera.ar" />
  <!-- Limits app visibility in the Google Play Store to ARCore supported devices
       (https://developers.google.com/ar/devices). -->
  <uses-feature android:glEsVersion="0x00020000" android:required="true" />

  <application
      android:name="com.google.ar.core.examples.kotlin.helloar.ARAppApplication"
      android:appCategory="game"
      android:allowBackup="false"
      android:icon="@drawable/ic_launcher"
      android:label="@string/app_name"
      android:theme="@style/AppTheme"
      android:usesCleartextTraffic="false"
      tools:ignore="GoogleAppIndexingWarning">

    <!-- アプリを開くと最初にマップ画面を出し、そこから AR の画面へ移る（バトルに出すモンスターが決まっていなければ、最初にモンスターを選ぶ画面へ移る） -->
    <activity
        android:name="com.google.ar.core.examples.kotlin.helloar.map.MapActivity"
        android:exported="true"
        android:theme="@style/Theme.AppCompat.Light.NoActionBar"
        android:screenOrientation="portrait">
      <intent-filter>
        <action android:name="android.intent.action.MAIN"/>
        <category android:name="android.intent.category.LAUNCHER"/>
      </intent-filter>
    </activity>
    <activity
        android:name="com.google.ar.core.examples.kotlin.helloar.capture.CaptureActivity"
        android:configChanges="orientation|screenSize"
        android:exported="false"
        android:theme="@style/Theme.AppCompat.NoActionBar"
        android:screenOrientation="portrait" />
    <!-- 最初にモンスターを選ぶ画面（バトルに出すモンスターがまだ決まっていないとき、マップ画面から開く） -->
    <activity
        android:name="com.google.ar.core.examples.kotlin.helloar.starter.StarterMonsterActivity"
        android:exported="false"
        android:theme="@style/Theme.AppCompat.Light.NoActionBar"
        android:screenOrientation="portrait"/>
    <!-- マルチバトル（マップ画面の「マルチバトル」ボタンから開く） -->
    <activity
        android:name="com.google.ar.core.examples.kotlin.helloar.battle.BattleActivity"
        android:exported="false"
        android:theme="@style/Theme.AppCompat.NoActionBar"
        android:screenOrientation="portrait"/>
    <!-- Indicates whether "Google Play Services for AR" (ARCore) is "required" or "optional". -->
    <!-- SceneView は optional にしているが、このアプリは AR が必須なので required で上書きする -->
    <meta-data android:name="com.google.ar.core" android:value="required" tools:replace="android:value" />
  </application>
</manifest>
